#!/usr/bin/env python3
"""cx: command-line helpers for the agentic CX manual.

Only `cx check` exists today. It reads the banned lists in
floor/voice/LEXICON.md and scans a reply for them.

    scripts/cx check reply.md          check one or more files
    scripts/cx check - < reply.md      check stdin
    scripts/cx check --gold            check every gold reply in floor/evals/cases/
    scripts/cx check --templates       check the examples in templates/customer/
    scripts/cx check --strict ...      treat warnings as failures

Exit codes: 0 clean, 1 at least one violation, 2 usage or lexicon error.
"""

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LEXICON = ROOT / "floor" / "voice" / "LEXICON.md"
CASES = ROOT / "floor" / "evals" / "cases"
TEMPLATES = ROOT / "templates" / "customer"

BLOCK_KINDS = ("banned-phrases", "banned-words", "banned-openers", "banned-patterns")
SALUTATION = re.compile(r"^(subject:.*|(hi|hey|hello|dear|morning|good morning|good afternoon)\b[^\n]{0,60},?)$", re.I)
EMOJI = re.compile("[\U0001F300-\U0001FAFF☀-➿]")


@dataclass
class Lexicon:
    phrases: list
    words: list
    openers: list
    patterns: list
    substitutes: dict


@dataclass
class Finding:
    source: str
    line: int
    col: int
    kind: str
    text: str
    hint: str = ""
    warning: bool = False

    def __str__(self):
        level = "warning" if self.warning else "error"
        out = f"{self.source}:{self.line}:{self.col}: {level}: {self.kind}: {self.text!r}"
        return out + (f" -> {self.hint}" if self.hint else "")


def normalize(text):
    """Straight quotes, so "don’t" matches "don't". Same length, so offsets hold."""
    return text.replace("’", "'").replace("‘", "'").replace("“", '"').replace("”", '"')


def load_lexicon(path=LEXICON):
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as e:
        raise SystemExit(f"cx: cannot read lexicon at {path}: {e}")
    blocks = {kind: [] for kind in BLOCK_KINDS}
    for m in re.finditer(r"^```([a-z-]+)\n(.*?)^```", raw, re.S | re.M):
        kind = m.group(1)
        if kind in blocks:
            # Keep pattern lines exactly, including significant leading and trailing spaces.
            blocks[kind] = [line for line in m.group(2).split("\n") if line.strip()]
    missing = [k for k, v in blocks.items() if not v]
    if missing:
        raise SystemExit(f"cx: lexicon is missing blocks: {', '.join(missing)}")
    patterns = []
    for p in blocks["banned-patterns"]:
        try:
            patterns.append((p, re.compile(p)))
        except re.error as e:
            raise SystemExit(f"cx: bad pattern in lexicon {p!r}: {e}")
    substitutes = {}
    table = re.search(r"## Preferred substitutes\s*\n(.*?)(?:\n## |\Z)", raw, re.S)
    if table:
        for row in table.group(1).splitlines():
            cells = [c.strip() for c in row.strip().strip("|").split("|")]
            if len(cells) == 2 and cells[0] and not set(cells[0]) <= set("-") and cells[0] != "Instead of":
                substitutes[normalize(cells[0]).lower()] = cells[1]
    return Lexicon(
        phrases=[normalize(p.strip()).lower() for p in blocks["banned-phrases"]],
        words=[w.strip().lower() for w in blocks["banned-words"]],
        openers=[o.strip() for o in blocks["banned-openers"]],
        patterns=patterns,
        substitutes=substitutes,
    )


def blank(match):
    """Replace a match with spaces, keeping newlines, so offsets and line numbers hold."""
    return re.sub(r"[^\n]", " ", match.group(0))


def prepare(text):
    text = normalize(text)
    text = re.sub(r"^```.*?^```[^\n]*$", blank, text, flags=re.S | re.M)  # fenced code
    text = re.sub(r"`[^`\n]+`", blank, text)  # inline code
    text = re.sub(r"^[ \t]*>[ \t]?", blank, text, flags=re.M)  # blockquote markers
    return text


def position(text, offset, first_line):
    line = text.count("\n", 0, offset)
    col = offset - (text.rfind("\n", 0, offset) + 1)
    return first_line + line, col + 1


def hint_for(lex, matched):
    key = matched.lower()
    for instead, say in lex.substitutes.items():
        if key == instead or key in instead or instead in key:
            return say
    return ""


def body_start(text):
    """Offset of the first line that is not a subject, salutation, or blank."""
    offset = 0
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped and not SALUTATION.match(stripped):
            return offset + (len(line) - len(line.lstrip()))
        offset += len(line) + 1
    return None


def check_text(raw, lex, source, first_line=1):
    text = prepare(raw)
    lower = text.lower()
    found = []

    def add(kind, start, end, warning=False, hint=None):
        line, col = position(text, start, first_line)
        matched = raw[start:end] if end <= len(raw) else text[start:end]
        matched = " ".join(matched.split()) or text[start:end]
        found.append(Finding(source, line, col, kind, matched, hint_for(lex, matched) if hint is None else hint, warning))

    for phrase in lex.phrases:
        for m in re.finditer(r"(?<![\w'])" + re.escape(phrase) + r"(?![\w'])", lower):
            add("banned phrase", m.start(), m.end())
    for word in lex.words:
        for m in re.finditer(r"\b" + re.escape(word) + r"\b", lower):
            add("banned word", m.start(), m.end())
    start = body_start(text)
    if start is not None:
        for opener in lex.openers:
            if re.match(re.escape(opener) + r"\b", text[start:], re.I):
                add("banned opener", start, start + len(opener))
                break
    for source_pattern, pattern in lex.patterns:
        for m in pattern.finditer(text):
            add("structural tell", m.start(), m.end(), hint=f"pattern {source_pattern!r}")

    # "Allowed, with care" in the lexicon: warnings, not failures.
    bangs = [m.start() for m in re.finditer(r"!", text)]
    if len(bangs) > 1:
        add("more than one exclamation point", bangs[1], bangs[1] + 1, warning=True, hint="one per message, only when genuine")
    emoji = list(EMOJI.finditer(text))
    if len(emoji) > 1:
        add("more than one emoji", emoji[1].start(), emoji[1].end(), warning=True, hint="one at most, end of an upbeat line")
    sorry = list(re.finditer(r"\b(sorry|apologi[sz]e)\b", lower))
    if len(sorry) > 1:
        add("apologized more than once", sorry[1].start(), sorry[1].end(), warning=True, hint="once, attached to a specific thing")

    found.sort(key=lambda f: (f.line, f.col))
    return found


def sections(path, heading):
    """Yield (text, first_line) for each '## <heading>' section in a markdown file."""
    raw = path.read_text(encoding="utf-8")
    pattern = re.compile(r"^## " + re.escape(heading) + r"[ \t]*\n(.*?)(?=^## |\Z)", re.S | re.M)
    for m in pattern.finditer(raw):
        yield m.group(1), raw.count("\n", 0, m.start(1)) + 1


def targets(args):
    if args.gold:
        for path in sorted(CASES.glob("*.md")):
            for text, line in sections(path, "Gold reply"):
                yield str(path.relative_to(ROOT)), text, line
    if args.templates:
        for path in sorted(TEMPLATES.glob("*.md")):
            for text, line in sections(path, "Example"):
                yield str(path.relative_to(ROOT)), text, line
    for name in args.files:
        if name == "-":
            yield "<stdin>", sys.stdin.read(), 1
        else:
            try:
                yield name, Path(name).read_text(encoding="utf-8"), 1
            except OSError as e:
                raise SystemExit(f"cx: cannot read {name}: {e}")


def cmd_check(args):
    if not (args.files or args.gold or args.templates):
        print("cx check: give a file, '-' for stdin, --gold, or --templates", file=sys.stderr)
        return 2
    lex = load_lexicon(Path(args.lexicon) if args.lexicon else LEXICON)
    errors = warnings = checked = 0
    for source, text, line in targets(args):
        checked += 1
        for finding in check_text(text, lex, source, line):
            print(finding)
            if finding.warning and not args.strict:
                warnings += 1
            else:
                errors += 1
    if not args.quiet:
        print(f"cx check: {checked} checked, {errors} error(s), {warnings} warning(s)", file=sys.stderr)
    return 1 if errors else 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="cx", description="Helpers for the agentic CX manual.")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check", help="scan replies against the banned lists in floor/voice/LEXICON.md")
    check.add_argument("files", nargs="*", help="files to check, or '-' for stdin")
    check.add_argument("--gold", action="store_true", help="check every gold reply in floor/evals/cases/")
    check.add_argument("--templates", action="store_true", help="check the examples in templates/customer/")
    check.add_argument("--strict", action="store_true", help="treat warnings as errors")
    check.add_argument("--quiet", action="store_true", help="no summary line")
    check.add_argument("--lexicon", help="path to a different lexicon file")
    args = parser.parse_args(argv)
    if args.command == "check":
        return cmd_check(args)
    return 2


if __name__ == "__main__":
    sys.exit(main())
