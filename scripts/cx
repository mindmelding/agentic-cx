#!/usr/bin/env python3
"""cx: command-line helpers for the agentic CX manual.

    scripts/cx init                    create the private files: local/, the overlay, the queues, consent
    scripts/cx doctor                  say what is set up, what is missing, and the next step
    scripts/cx status                  what is waiting: the queue, the inbox, the stack, the last day note
    scripts/cx models                  print which model runs which skill, per harness
    scripts/cx run open                run a skill unattended, within local/consent.toml
    scripts/cx run close --dry-run     print the command instead of running it

    scripts/cx spec new <class>        start a spec file in specs/
    scripts/cx spec lint               check the spec register: fields, rungs, sources that exist
    scripts/cx spec check --base main  name the specs a change touched and the doc decision each needs

    scripts/cx mcp config claude       print the MCP setup for a host: claude, codex, cursor, gemini, vscode, json
    scripts/cx mcp serve               the MCP server itself, over stdio. Hosts start it

    scripts/cx check reply.md          check one or more files against the lexicon
    scripts/cx check - < reply.md      check stdin
    scripts/cx check --gold            check every gold reply in floor/evals/cases/
    scripts/cx check --templates       check the examples in templates/customer/
    scripts/cx check --strict ...      treat warnings as failures

Exit codes: 0 clean, 1 a violation or a failed check, 2 usage or config error.
`run` passes through the harness's exit code.
"""

import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11. Only check works without it.
    tomllib = None

ROOT = Path(__file__).resolve().parent.parent
LEXICON = ROOT / "floor" / "voice" / "LEXICON.md"
CASES = ROOT / "floor" / "evals" / "cases"
TEMPLATES = ROOT / "templates" / "customer"
OVERLAY_TEMPLATES = ROOT / "templates" / "house" / "overlay"
MODELS = ROOT / "models.toml"

BLOCK_KINDS = ("banned-phrases", "banned-words", "banned-openers", "banned-patterns")
SALUTATION = re.compile(r"^(subject:.*|(hi|hey|hello|dear|morning|good morning|good afternoon)\b[^\n]{0,60},?)$", re.I)
EMOJI = re.compile("[\U0001F300-\U0001FAFF☀-➿]")


@dataclass
class Lexicon:
    phrases: list
    words: list
    openers: list
    patterns: list
    substitutes: dict


@dataclass
class Finding:
    source: str
    line: int
    col: int
    kind: str
    text: str
    hint: str = ""
    warning: bool = False

    def __str__(self):
        level = "warning" if self.warning else "error"
        out = f"{self.source}:{self.line}:{self.col}: {level}: {self.kind}: {self.text!r}"
        return out + (f" -> {self.hint}" if self.hint else "")


def normalize(text):
    """Straight quotes, so "don’t" matches "don't". Same length, so offsets hold."""
    return text.replace("’", "'").replace("‘", "'").replace("“", '"').replace("”", '"')


def load_lexicon(path=LEXICON):
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as e:
        raise SystemExit(f"cx: cannot read lexicon at {path}: {e}")
    blocks = {kind: [] for kind in BLOCK_KINDS}
    for m in re.finditer(r"^```([a-z-]+)\n(.*?)^```", raw, re.S | re.M):
        kind = m.group(1)
        if kind in blocks:
            # Keep pattern lines exactly, including significant leading and trailing spaces.
            blocks[kind] = [line for line in m.group(2).split("\n") if line.strip()]
    missing = [k for k, v in blocks.items() if not v]
    if missing:
        raise SystemExit(f"cx: lexicon is missing blocks: {', '.join(missing)}")
    patterns = []
    for p in blocks["banned-patterns"]:
        try:
            patterns.append((p, re.compile(p)))
        except re.error as e:
            raise SystemExit(f"cx: bad pattern in lexicon {p!r}: {e}")
    substitutes = {}
    table = re.search(r"## Preferred substitutes\s*\n(.*?)(?:\n## |\Z)", raw, re.S)
    if table:
        for row in table.group(1).splitlines():
            cells = [c.strip() for c in row.strip().strip("|").split("|")]
            if len(cells) == 2 and cells[0] and not set(cells[0]) <= set("-") and cells[0] != "Instead of":
                substitutes[normalize(cells[0]).lower()] = cells[1]
    return Lexicon(
        phrases=[normalize(p.strip()).lower() for p in blocks["banned-phrases"]],
        words=[w.strip().lower() for w in blocks["banned-words"]],
        openers=[o.strip() for o in blocks["banned-openers"]],
        patterns=patterns,
        substitutes=substitutes,
    )


def blank(match):
    """Replace a match with spaces, keeping newlines, so offsets and line numbers hold."""
    return re.sub(r"[^\n]", " ", match.group(0))


def prepare(text):
    text = normalize(text)
    text = re.sub(r"^```.*?^```[^\n]*$", blank, text, flags=re.S | re.M)  # fenced code
    text = re.sub(r"`[^`\n]+`", blank, text)  # inline code
    text = re.sub(r"^[ \t]*>[ \t]?", blank, text, flags=re.M)  # blockquote markers
    return text


def position(text, offset, first_line):
    line = text.count("\n", 0, offset)
    col = offset - (text.rfind("\n", 0, offset) + 1)
    return first_line + line, col + 1


def hint_for(lex, matched):
    key = matched.lower()
    for instead, say in lex.substitutes.items():
        if key == instead or key in instead or instead in key:
            return say
    return ""


def body_start(text):
    """Offset of the first line that is not a subject, salutation, or blank."""
    offset = 0
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped and not SALUTATION.match(stripped):
            return offset + (len(line) - len(line.lstrip()))
        offset += len(line) + 1
    return None


def check_text(raw, lex, source, first_line=1):
    text = prepare(raw)
    lower = text.lower()
    found = []

    def add(kind, start, end, warning=False, hint=None):
        line, col = position(text, start, first_line)
        matched = raw[start:end] if end <= len(raw) else text[start:end]
        matched = " ".join(matched.split()) or text[start:end]
        found.append(Finding(source, line, col, kind, matched, hint_for(lex, matched) if hint is None else hint, warning))

    for phrase in lex.phrases:
        for m in re.finditer(r"(?<![\w'])" + re.escape(phrase) + r"(?![\w'])", lower):
            add("banned phrase", m.start(), m.end())
    for word in lex.words:
        for m in re.finditer(r"\b" + re.escape(word) + r"\b", lower):
            add("banned word", m.start(), m.end())
    start = body_start(text)
    if start is not None:
        for opener in lex.openers:
            if re.match(re.escape(opener) + r"\b", text[start:], re.I):
                add("banned opener", start, start + len(opener))
                break
    for source_pattern, pattern in lex.patterns:
        for m in pattern.finditer(text):
            add("structural tell", m.start(), m.end(), hint=f"pattern {source_pattern!r}")

    # "Allowed, with care" in the lexicon: warnings, not failures.
    bangs = [m.start() for m in re.finditer(r"!", text)]
    if len(bangs) > 1:
        add("more than one exclamation point", bangs[1], bangs[1] + 1, warning=True, hint="one per message, only when genuine")
    emoji = list(EMOJI.finditer(text))
    if len(emoji) > 1:
        add("more than one emoji", emoji[1].start(), emoji[1].end(), warning=True, hint="one at most, end of an upbeat line")
    sorry = list(re.finditer(r"\b(sorry|apologi[sz]e)\b", lower))
    if len(sorry) > 1:
        add("apologized more than once", sorry[1].start(), sorry[1].end(), warning=True, hint="once, attached to a specific thing")

    found.sort(key=lambda f: (f.line, f.col))
    return found


def sections(path, heading):
    """Yield (text, first_line) for each '## <heading>' section in a markdown file."""
    raw = path.read_text(encoding="utf-8")
    pattern = re.compile(r"^## " + re.escape(heading) + r"[ \t]*\n(.*?)(?=^## |\Z)", re.S | re.M)
    for m in pattern.finditer(raw):
        yield m.group(1), raw.count("\n", 0, m.start(1)) + 1


def targets(args):
    if args.gold:
        for path in sorted(CASES.glob("*.md")):
            for text, line in sections(path, "Gold reply"):
                yield str(path.relative_to(ROOT)), text, line
    if args.templates:
        for path in sorted(TEMPLATES.glob("*.md")):
            for text, line in sections(path, "Example"):
                yield str(path.relative_to(ROOT)), text, line
    for name in args.files:
        if name == "-":
            yield "<stdin>", sys.stdin.read(), 1
        else:
            try:
                yield name, Path(name).read_text(encoding="utf-8"), 1
            except OSError as e:
                raise SystemExit(f"cx: cannot read {name}: {e}")


def cmd_check(args):
    if not (args.files or args.gold or args.templates):
        print("cx check: give a file, '-' for stdin, --gold, or --templates", file=sys.stderr)
        return 2
    lex = load_lexicon(Path(args.lexicon) if args.lexicon else LEXICON)
    errors = warnings = checked = 0
    for source, text, line in targets(args):
        checked += 1
        for finding in check_text(text, lex, source, line):
            print(finding)
            if finding.warning and not args.strict:
                warnings += 1
            else:
                errors += 1
    if not args.quiet:
        print(f"cx check: {checked} checked, {errors} error(s), {warnings} warning(s)", file=sys.stderr)
    return 1 if errors else 0


# --- Setup and unattended runs ------------------------------------------------
#
# The kit is the manual: this repo. The house is where one company's private files
# live: stack.md, the two queues, and local/. In a clone the house is the repo root,
# and all of it is gitignored. Set CX_HOUSE to keep it anywhere else, which is what
# an install that updates the kit in place needs.


def house_dir():
    value = os.environ.get("CX_HOUSE", "").strip()
    return Path(value).expanduser().resolve() if value else ROOT

class CxError(Exception):
    """A refusal or a config problem. main() prints it and exits 2."""


PRIVATE = ("stack.md", "voice-queue.md", "context-inbox.md", "local/")

# Skills that make sense with nobody answering. The rest wait on a person:
# setup interviews, floor needs a customer in front of you, triage files only
# after a yes, refresh edits the tracked manual.
UNATTENDED = ("open", "close")

SKILL_FILES = {
    "setup": "skill/SKILL.md",
    "open": "skills/open/SKILL.md",
    "floor": "skills/floor/SKILL.md",
    "triage": "skills/triage/SKILL.md",
    "close": "skills/close/SKILL.md",
    "refresh": "skills/refresh/SKILL.md",
}

CONSENT = """\
# What an unattended run may read and use. `cx run` reads this before it starts.
#
# Setup (skill/SKILL.md, step 0) records each yes here. Edit it by hand to take
# one back. Nothing in this file is a secret: never put a key or token here.
# Nothing is sent outside the company from an unattended run, whatever this says.

[read]
# Summaries of past chats and agent memory on this machine.
past_chats = false
# The names of the connectors your agent hosts have configured. Never the keys.
connector_config = false
# A product repo to scan, as a path. Empty for none.
product_repo = ""

[connectors]
# Connectors an unattended run may call, by the name your host knows them by,
# e.g. ["moonbase", "linear"]. Read access is enough for open and close.
allowed = []

[unattended]
# Skills `cx run` may start with nobody answering. Only open and close qualify.
skills = ["open", "close"]
"""

RUN_PROMPT = """\
Today is {today}. Run {skill} and follow it. Resolve its links from that file.

The working directory is the house, where this company's private files live: stack.md,
voice-queue.md, context-inbox.md, and local/. Paths to those in the skill are relative to it.

This is an unattended run. Nobody will answer a question.
- Read local/consent.toml first. Read nothing it does not allow, and call only the connectors it lists.
- Write only to local/, voice-queue.md, and context-inbox.md. Edit no tracked file.
- Send nothing and file nothing. Nothing leaves the company from this run.
- Where the skill waits for a yes, do not wait. List it under "Waiting on you" at the end and move on.
End with the board or the day note, as the skill says, and nothing after it."""


def write_new(path, text):
    """Write text to path unless it exists. Return True if written."""
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    return True


def init_house(house=ROOT):
    """Create the private files. Never overwrites. Returns (created, kept) as relative paths."""
    created, kept = [], []

    def note(path, made):
        (created if made else kept).append(str(path.relative_to(house)))

    for d in ("local/learnings/days", "local/runs"):
        (house / d).mkdir(parents=True, exist_ok=True)
    for src in sorted(OVERLAY_TEMPLATES.iterdir()):
        if src.is_file():
            dest = house / "local" / "overlay" / src.name
            note(dest, write_new(dest, src.read_text(encoding="utf-8")))
    index = house / "local" / "learnings" / "index.md"
    note(index, write_new(index, (ROOT / "learnings" / "index.md").read_text(encoding="utf-8")))
    note(house / "local/consent.toml", write_new(house / "local/consent.toml", CONSENT))
    for name in ("voice-queue.md", "context-inbox.md"):
        note(house / name, write_new(house / name, (ROOT / "templates" / "house" / "state" / name).read_text(encoding="utf-8")))
    return created, kept


def need_toml():
    if tomllib is None:
        raise CxError("this command needs Python 3.11 or newer (tomllib)")


def load_toml(path):
    need_toml()
    with open(path, "rb") as f:
        return tomllib.load(f)


def load_consent(house=ROOT):
    """The parsed consent file, or None if init has not run."""
    path = house / "local" / "consent.toml"
    if not path.exists():
        return None
    try:
        return load_toml(path)
    except tomllib.TOMLDecodeError as e:
        raise CxError(f"cannot parse {path}: {e}")


def allowed_connectors(consent):
    names = (consent or {}).get("connectors", {}).get("allowed", [])
    return [n for n in names if isinstance(n, str) and re.fullmatch(r"[A-Za-z0-9_-]+", n)]


def configured_connectors(house=ROOT):
    """Connector names from each host's config file. Names only: values are never read out."""
    home = Path.home()
    found = {}

    def add(host, names):
        for n in names:
            found.setdefault(n, set()).add(host)

    def json_servers(path, *keys):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}
        for k in keys:
            data = data.get(k, {}) if isinstance(data, dict) else {}
        return data if isinstance(data, dict) else {}

    claude = home / ".claude.json"
    add("claude", json_servers(claude, "mcpServers"))
    add("claude", json_servers(claude, "projects", str(house), "mcpServers"))
    add("claude", json_servers(house / ".mcp.json", "mcpServers"))
    add("cursor", json_servers(home / ".cursor" / "mcp.json", "mcpServers"))
    add("cursor", json_servers(house / ".cursor" / "mcp.json", "mcpServers"))
    add("gemini", json_servers(home / ".gemini" / "settings.json", "mcpServers"))
    codex = home / ".codex" / "config.toml"
    if codex.exists() and tomllib is not None:
        try:
            add("codex", load_toml(codex).get("mcp_servers", {}))
        except tomllib.TOMLDecodeError:
            pass
    return found


def env_refs(text):
    """Environment variable names referenced as ${env:NAME} or $NAME."""
    return sorted(set(re.findall(r"\$\{env:([A-Z0-9_]+)\}", text)) | set(re.findall(r"\$([A-Z][A-Z0-9_]+)\b", text)))


def in_git_repo(path):
    try:
        r = subprocess.run(["git", "-C", str(path), "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
    except OSError:
        return None
    return r.returncode == 0 and r.stdout.strip() == "true"


def git_ignored(house, rel):
    try:
        r = subprocess.run(["git", "-C", str(house), "check-ignore", "-q", rel], capture_output=True)
    except OSError:
        return None
    return {0: True, 1: False}.get(r.returncode)


def doctor(house=ROOT, models=MODELS):
    """Return a list of (level, message) where level is ok, warn, or fail."""
    out = []
    ok = lambda m: out.append(("ok", m))
    warn = lambda m: out.append(("warn", m))
    fail = lambda m: out.append(("fail", m))

    if tomllib is None:
        fail("Python 3.11 or newer is needed for everything but `cx check`.")

    ok(f"House: {house}" + ("" if house == ROOT else " (from CX_HOUSE)") + f". Manual: {ROOT}.")
    if house != ROOT and not house.is_dir():
        fail(f"CX_HOUSE points at {house}, which does not exist. Create it, then `scripts/cx init`.")
        return out
    ignored = {rel: git_ignored(house, rel) for rel in PRIVATE}
    if house != ROOT and in_git_repo(house) is False:
        ok("The house is outside any git repository, so nothing in it can be committed by accident.")
    elif None in ignored.values():
        warn("Not a git checkout, or git is missing. Cannot confirm the private files stay out of git.")
    elif all(ignored.values()):
        ok("Private files are gitignored: " + ", ".join(PRIVATE))
    else:
        fail("Not gitignored, so customer data could be committed: " + ", ".join(r for r, v in ignored.items() if not v))

    consent = None
    if not (house / "local").is_dir():
        fail("Not initialized. Run `scripts/cx init`.")
    else:
        missing = [n for n in ("local/consent.toml", "voice-queue.md", "context-inbox.md") if not (house / n).exists()]
        if missing:
            fail("Missing " + ", ".join(missing) + ". Run `scripts/cx init`; it only adds what is missing.")
        else:
            ok("Initialized: local/, consent, and both queues exist.")
        try:
            consent = load_consent(house)
        except CxError as e:
            fail(str(e))

    if consent is not None:
        skills = consent.get("unattended", {}).get("skills", [])
        bad = [s for s in skills if s not in UNATTENDED]
        if bad:
            fail(f"consent.toml lists {', '.join(bad)} as unattended. Only {', '.join(UNATTENDED)} can run with nobody answering.")
        reads = [k for k, v in consent.get("read", {}).items() if v]
        ok("Consent recorded. Reads allowed: " + (", ".join(reads) or "none") + ". Connectors allowed: " + (", ".join(allowed_connectors(consent)) or "none") + ".")

    if (house / "stack.md").exists() and (house / "local" / "assessment.md").exists():
        ok("Set up: stack.md and local/assessment.md exist.")
    else:
        warn("Setup has not run. In Claude Code, `/cx-setup`. Elsewhere, \"Run the setup skill.\"")

    _, problems = house_status(house)
    if problems:
        for source, line, message in problems[:8]:
            warn(f"{source}{f':{line}' if line else ''}: {message}")
        if len(problems) > 8:
            warn(f"{len(problems) - 8} more line(s) cx cannot read. The shapes are in templates/house/state/.")
    elif (house / "voice-queue.md").exists():
        ok("State files read cleanly.")

    overlay = house / "local" / "overlay"
    if overlay.is_dir():
        same = [p.name for p in sorted(OVERLAY_TEMPLATES.iterdir()) if p.is_file() and (overlay / p.name).exists()
                and (overlay / p.name).read_bytes() == p.read_bytes()]
        if same:
            warn("Overlay still the template: " + ", ".join(same) + ". Setup step 7 fills it. Until then every grant is zero.")
        else:
            ok("Overlay filled in.")
        mcp = overlay / "mcp.json"
        if mcp.exists() and mcp.name not in same:
            unset = [n for n in env_refs(mcp.read_text(encoding="utf-8")) if not os.environ.get(n)]
            if unset:
                warn("local/overlay/mcp.json needs environment variables that are not set: " + ", ".join(unset) + ".")

    if consent is not None:
        wanted = allowed_connectors(consent)
        if wanted and not consent.get("read", {}).get("connector_config"):
            warn("Connectors are allowed but reading connector config is not, so they cannot be checked. Set read.connector_config = true to check.")
        elif wanted:
            found = configured_connectors(house)
            for name in wanted:
                if name in found:
                    ok(f"Connector {name} is configured in: {', '.join(sorted(found[name]))}.")
                else:
                    warn(f"Connector {name} is not in any config file cx can read. If it is a claude.ai connector, check with /mcp.")

    try:
        table = load_toml(models) if tomllib else {}
    except (OSError, tomllib.TOMLDecodeError) as e:
        fail(f"Cannot read {models.name}: {e}")
        table = {}
    harnesses = [h for h, spec in table.get("harness", {}).items() if shutil.which(spec.get("command", [""])[0])]
    if harnesses:
        ok("Harnesses on PATH: " + ", ".join(harnesses) + f". `cx run` uses {harnesses[0]} unless --harness or CX_HARNESS says otherwise.")
    elif table:
        warn("No agent harness on PATH (" + ", ".join(table.get("harness", {})) + "). `cx run` needs one.")
    return out


def cmd_init(args):
    need_toml()
    house = house_dir()
    house.mkdir(parents=True, exist_ok=True)
    created, kept = init_house(house)
    if house != ROOT:
        print(f"house    {house}")
    for rel in created:
        print(f"created  {rel}")
    if kept and not args.quiet:
        print(f"kept     {len(kept)} existing file(s)")
    print("Next: `scripts/cx doctor`, then run setup in your agent (`/cx-setup` in Claude Code).")
    return 0


def cmd_doctor(args):
    results = doctor(house_dir())
    for level, message in results:
        print(f"{level:<5} {message}")
    return 1 if any(level == "fail" for level, _ in results) else 0


def load_models(path=MODELS):
    try:
        return load_toml(path)
    except OSError as e:
        raise CxError(f"cannot read {path}: {e}")


def pick_harness(models, name=None):
    harnesses = models.get("harness", {})
    name = name or os.environ.get("CX_HARNESS")
    if name:
        if name not in harnesses:
            raise CxError(f"unknown harness {name!r}. models.toml has: {', '.join(harnesses)}")
        return name
    for h, spec in harnesses.items():
        if shutil.which(spec.get("command", [""])[0]):
            return h
    raise CxError("no agent harness on PATH. Install one, or pass --harness to see the command with --dry-run.")


def model_for(models, harness, skill, moment=None, today=None):
    """Return (tier, model). An empty model means the harness default.

    Friday's close does the weekly pass, so it takes the `friday` tier.
    """
    if skill == "close" and today is not None and today.weekday() == 4:
        skill = "friday"
    tier = models.get("skills", {}).get(skill, "standard")
    if skill == "floor" and moment:
        tier = models.get("moments", {}).get(moment, tier)
    return tier, models.get("harness", {}).get(harness, {}).get(tier, "")


def build_command(template, values, allow):
    """Fill a models.toml command template.

    {model} left empty drops the token and the flag before it. {allow} becomes one
    argument per entry, and drops its flag when the list is empty.
    """
    cmd = []
    for token in template:
        if "{model}" in token and not values["model"]:
            if cmd and cmd[-1].startswith("-"):
                cmd.pop()
            continue
        if token == "{allow}":
            if allow:
                cmd.extend(allow)
            elif cmd and cmd[-1].startswith("-"):
                cmd.pop()
            continue
        cmd.append(token.format(**values))
    # Kit and house are often the same folder. One --add-dir for it is enough.
    out, seen, i = [], set(), 0
    while i < len(cmd):
        if cmd[i] == "--add-dir" and i + 1 < len(cmd):
            if cmd[i + 1] not in seen:
                seen.add(cmd[i + 1])
                out += cmd[i:i + 2]
            i += 2
            continue
        out.append(cmd[i])
        i += 1
    return out


def run_plan(models, consent, skill, harness, kit=ROOT, house=ROOT, today=None):
    """Everything `cx run` needs: (command, tier, model, scoped). Raises CxError on a refusal."""
    if consent is None:
        raise CxError("not initialized. Run `scripts/cx init`, then setup, first.")
    if skill not in UNATTENDED:
        raise CxError(f"{skill} waits on a person, so it does not run unattended. Open your agent and ask for it.")
    if skill not in consent.get("unattended", {}).get("skills", []):
        raise CxError(f"local/consent.toml does not list {skill} under [unattended] skills.")
    spec = models["harness"][harness]
    today = today or datetime.date.today()
    tier, model = model_for(models, harness, skill, today=today)
    skill_path = SKILL_FILES[skill] if Path(kit) == Path(house) else str(Path(kit) / SKILL_FILES[skill])
    prompt = RUN_PROMPT.format(skill=skill_path, today=today.strftime("%A %Y-%m-%d"))
    scoped = "{allow}" in spec["command"]
    allow = list(spec.get("allow", [])) + [f"mcp__{n}" for n in allowed_connectors(consent)]
    values = {"prompt": prompt, "model": model, "kit": str(kit), "house": str(house)}
    return build_command(spec["command"], values, allow), tier, model, scoped


def cmd_models(args):
    models = load_models()
    harnesses = [args.harness] if args.harness else list(models.get("harness", {}))
    for h in harnesses:
        if h not in models.get("harness", {}):
            raise CxError(f"unknown harness {h!r}")
        print(f"[{h}]")
        rows = [(skill, model_for(models, h, skill)) for skill in models.get("skills", {})]
        rows += [(f"floor:{m}", model_for(models, h, "floor", m)) for m in models.get("moments", {})]
        width = max(len(name) for name, _ in rows)
        for name, (tier, model) in rows:
            print(f"  {name:<{width}}  {tier:<9} {model or '(harness default)'}")
    return 0


def cmd_run(args):
    models = load_models()
    harness = pick_harness(models, args.harness)
    house = house_dir()
    command, tier, model, scoped = run_plan(models, load_consent(house), args.skill, harness, house=house)
    if not scoped:
        print(f"cx: {harness} cannot scope tools per run. The consent rules reach it through the prompt only.", file=sys.stderr)
    if args.dry_run:
        print(shlex.join(command))
        return 0
    log = house / "local" / "runs" / f"{datetime.date.today().isoformat()}-{args.skill}.md"
    log.parent.mkdir(parents=True, exist_ok=True)
    print(f"cx: {args.skill} on {harness}, {tier} tier, {model or 'harness default'}. Output also goes to {log}", file=sys.stderr)
    try:
        proc = subprocess.Popen(command, cwd=house, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        raise CxError(f"cannot start {command[0]}: {e}")
    with open(log, "a", encoding="utf-8") as f:
        f.write(f"\n<!-- {datetime.datetime.now().isoformat(timespec='seconds')} {harness} {model or 'default'} -->\n")
        for line in proc.stdout:
            sys.stdout.write(line)
            f.write(line)
        code = proc.wait()
        f.write(f"\n<!-- exit {code} -->\n")
    return code


# --- State files: what the skills write, read back ---------------------------
#
# The shapes are in templates/house/state/. Each loader returns what it read and a
# list of problems, (file, line, message), rather than stopping at the first one.

STATE_TEMPLATES = ROOT / "templates" / "house" / "state"
STACK_STATUSES = ("found", "partial", "absent")
VOICE_COLUMNS = ["Flaw", "Quote", "Account", "Resolution", "Count", "Evidence", "Proposal", "State"]
INBOX_COLUMNS = ["When", "Account", "Fact", "Author", "Source"]
VOICE_STATE = re.compile(r"^(open|held:\s*\S.*|passed:\s*\S.*)$")


def capabilities(tools=ROOT / "tools.md"):
    """{section: [capability]} from the tables in tools.md."""
    out, section = {}, None
    for line in tools.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^### (.+)$", line)
        if m:
            section = m.group(1).strip()
            continue
        if line.startswith("## "):
            section = None
        cells = split_row(line) if section and line.startswith("|") else None
        if cells and cells[0] not in ("Capability", "") and not set(cells[0]) <= set("-"):
            out.setdefault(section, []).append(cells[0])
    return out


def split_row(line):
    """Cells of one Markdown table row. `\\|` stays inside its cell."""
    parts = re.split(r"(?<!\\)\|", line.strip())
    if parts and parts[0] == "":
        parts = parts[1:]
    if parts and parts[-1] == "":
        parts = parts[:-1]
    return [p.strip().replace("\\|", "|") for p in parts]


def split_front_matter(text, source):
    """(fields, body, line number the body starts on, problems)."""
    if not text.startswith("---\n"):
        return {}, text, 1, []
    end = text.find("\n---", 3)
    if end == -1:
        return {}, text, 1, [(source, 1, "front matter opens with --- but never closes")]
    fields, problems = {}, []
    for n, line in enumerate(text[4:end].splitlines(), 2):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if m:
            fields[m.group(1)] = m.group(2).strip()
        else:
            problems.append((source, n, f"front matter line is not `key: value`: {line.strip()!r}"))
    body_start = text.count("\n", 0, end) + 2
    rest = text[end + 4:]
    return fields, rest.split("\n", 1)[1] if "\n" in rest else "", body_start + 1, problems


def parse_table(text, columns, source, first_line=1):
    """Rows, as dicts, of the first table whose header is exactly `columns`."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if line.startswith("|") and split_row(line) == columns:
            break
    else:
        return [], [(source, first_line, f"no table with the columns {' | '.join(columns)}")]
    rows, problems = [], []
    for j in range(i + 2, len(lines)):
        line = lines[j]
        if not line.startswith("|"):
            if line.strip():
                break
            continue
        cells = split_row(line)
        n = first_line + j
        if len(cells) != len(columns):
            problems.append((source, n, f"{len(cells)} cells, the table has {len(columns)}. Write a | inside a cell as \\|"))
            continue
        rows.append(dict(zip(columns, cells), _line=n))
    return rows, problems


def parse_when(value):
    """A date or an ISO 8601 time, or None."""
    try:
        return datetime.datetime.fromisoformat(value)
    except ValueError:
        try:
            return datetime.datetime.combine(datetime.date.fromisoformat(value), datetime.time())
        except ValueError:
            return None


def load_stack(path):
    source = path.name
    text = path.read_text(encoding="utf-8")
    fields, body, first, problems = split_front_matter(text, source)
    level = fields.get("ledger_level", "")
    if not re.fullmatch(r"[0-4]", level):
        problems.append((source, 1, f"`ledger_level` is 0 to 4, not {level!r}. See ledger.md"))
    if fields.get("updated") and not parse_when(fields["updated"]):
        problems.append((source, 1, f"`updated` is a date, YYYY-MM-DD, not {fields['updated']!r}"))
    expected = capabilities()
    rows, inward, section = [], [], None
    for n, line in enumerate(body.splitlines(), first):
        m = re.match(r"^## (.+)$", line)
        if m:
            section = m.group(1).strip()
            continue
        m = re.match(r"^\s*[-*] ([^:]+):\s*(.*)$", line)
        if not (m and section):
            continue
        name, rest = m.group(1).strip(), m.group(2).strip()
        if section.lower() == "inward":
            inward.append({"tool": name, "does": rest})
            continue
        s = re.match(r"^(found|partial|absent)\b[,;]?\s*(.*)$", rest, re.I)
        if not s:
            problems.append((source, n, f"`{name}` needs found, partial, or absent first, then where it lives"))
            continue
        if name not in expected.get(section, []):
            problems.append((source, n, f"`{name}` is not a capability under {section} in tools.md"))
        rows.append({"section": section, "capability": name, "status": s.group(1).lower(), "where": s.group(2), "_line": n})
    have = {(r["section"], r["capability"]) for r in rows}
    for section, names in expected.items():
        for name in names:
            if (section, name) not in have:
                problems.append((source, 0, f"no line for {section}: {name}"))
    return {"updated": fields.get("updated", ""), "ledger_level": int(level) if level.isdigit() else None,
            "capabilities": rows, "inward": inward}, problems


def load_voice(path):
    source = path.name
    fields, body, first, problems = split_front_matter(path.read_text(encoding="utf-8"), source)
    cursor = fields.get("cursor", "")
    if not cursor:
        problems.append((source, 1, "no `cursor` in the front matter. Open reads only what is newer than it"))
    elif cursor != "never" and not parse_when(cursor):
        problems.append((source, 1, f"`cursor` is `never` or an ISO 8601 time, not {cursor!r}"))
    rows, table_problems = parse_table(body, VOICE_COLUMNS, source, first)
    problems += table_problems
    for row in rows:
        if not re.fullmatch(r"[1-9]\d*", row["Count"]):
            problems.append((source, row["_line"], f"Count is a whole number, not {row['Count']!r}"))
        if not VOICE_STATE.match(row["State"]):
            problems.append((source, row["_line"], f"State is open, held: <reason>, or passed: <link>, not {row['State']!r}"))
        if row["Proposal"] and row["Proposal"].lower() not in ("pass", "hold"):
            problems.append((source, row["_line"], f"Proposal is pass or hold, not {row['Proposal']!r}"))
    return {"cursor": cursor, "items": rows}, problems


def load_inbox(path):
    source = path.name
    rows, problems = parse_table(path.read_text(encoding="utf-8"), INBOX_COLUMNS, source)
    for row in rows:
        if not parse_when(row["When"]):
            problems.append((source, row["_line"], f"When is a date or an ISO 8601 time, not {row['When']!r}"))
    return {"facts": rows}, problems


def latest_day_note(house):
    days = sorted((house / "local" / "learnings" / "days").glob("????-??-??.md"))
    if not days:
        return None
    text = days[-1].read_text(encoding="utf-8")
    m = re.search(r"^## Still open[ \t]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    still_open = [l.strip()[2:] for l in (m.group(1) if m else "").splitlines() if re.match(r"\s*[-*] ", l)]
    return {"date": days[-1].stem, "still_open": still_open}


def last_runs(house):
    """{skill: {date, exit}} from local/runs/, newest per skill."""
    out = {}
    for path in sorted((house / "local" / "runs").glob("????-??-??-*.md")):
        date, skill = path.stem[:10], path.stem[11:]
        codes = re.findall(r"<!-- exit (-?\d+) -->", path.read_text(encoding="utf-8"))
        out[skill] = {"date": date, "exit": int(codes[-1]) if codes else None}
    return out


def house_status(house=ROOT):
    """Everything `cx status` shows, plus the problems found reading it."""
    status, problems = {}, []
    for name, filename, loader in (("stack", "stack.md", load_stack), ("voice", "voice-queue.md", load_voice),
                                   ("inbox", "context-inbox.md", load_inbox)):
        path = house / filename
        if path.exists():
            status[name], found = loader(path)
            problems += found
        else:
            status[name] = None
    status["day_note"] = latest_day_note(house)
    status["runs"] = last_runs(house)
    return status, problems


def status_lines(status, problems, today=None):
    today = today or datetime.date.today()
    out = []
    stack = status["stack"]
    if stack is None:
        out.append(("Setup", "not run. `/cx-setup` in Claude Code, or \"Run the setup skill.\""))
    else:
        counts = {s: [r["capability"] for r in stack["capabilities"] if r["status"] == s] for s in STACK_STATUSES}
        level = stack["ledger_level"]
        out.append(("Setup", f"updated {stack['updated'] or '?'}, ledger level {level if level is not None else '?'}"))
        absent = counts["absent"]
        out.append(("Stack", f"{len(counts['found'])} found, {len(counts['partial'])} partial, {len(absent)} absent"
                    + (f" ({', '.join(absent[:4])}{', …' if len(absent) > 4 else ''})" if absent else "")))
    voice = status["voice"]
    if voice is None:
        out.append(("Voice", "no queue. `scripts/cx init` creates it"))
    else:
        states = [r["State"].split(":")[0] for r in voice["items"]]
        cursor = voice["cursor"] or "?"
        if cursor not in ("never", "?") and parse_when(cursor):
            age = (today - parse_when(cursor).date()).days
            cursor = f"{cursor[:16].replace('T', ' ')}" + (f", {age} days ago" if age > 1 else "")
        waiting = sum(1 for r in voice["items"] if r["State"] == "open")
        out.append(("Voice", f"{waiting} waiting on pass or hold, {states.count('held')} held, {states.count('passed')} passed. Read up to: {cursor}"))
    inbox = status["inbox"]
    if inbox is not None:
        out.append(("Context", f"{len(inbox['facts'])} fact(s) in context-inbox.md with no store yet" if inbox["facts"] else "inbox empty"))
    day = status["day_note"]
    if day is None:
        out.append(("Day note", "none yet. Close writes one"))
    else:
        out.append(("Day note", f"{day['date']}, {len(day['still_open'])} still open"))
    runs = status["runs"]
    if runs:
        out.append(("Runs", ", ".join(f"{s} {r['date']}" + ("" if r["exit"] in (0, None) else f" (exit {r['exit']})") for s, r in sorted(runs.items()))))
    if problems:
        out.append(("Problems", f"{len(problems)} line(s) cx cannot read. `scripts/cx doctor` lists them"))
    return out


def cmd_status(args):
    status, problems = house_status(house_dir())
    if args.json:
        clean = json.loads(json.dumps(status, default=str))
        clean["problems"] = [{"file": f, "line": n, "message": m} for f, n, m in problems]
        print(json.dumps(clean, indent=2))
        return 0
    for label, text in status_lines(status, problems):
        print(f"{label:<9} {text}")
    return 0


# --- Spec register: the documentation check -----------------------------------
#
# One file per action class (action-class.md), YAML, in the product repo. `cx spec`
# lints the register and, for a change, names the specs whose `sources` it touched
# and the doc disposition each still needs. The pull request is the decision log
# until a separate one exists.

SPEC_REQUIRED = ("class", "fires_when", "may", "never", "approval", "default_rung", "sources")
SPEC_LISTS = ("may", "never", "sources", "reach", "context_floor")
SPEC_RECOMMENDED = ("reach", "reversible", "context_floor")

# The dispositions in responsibilities/documentation.md, plus the words triage uses.
DISPOSITIONS = {
    "spec-only": "spec-only", "no-page": "spec-only", "no-documentation": "spec-only",
    "page": "page", "promise-line": "page",
    "guide": "guide",
    "update": "update",
    "remove": "remove",
}
DISPOSITION_LINE = re.compile(r"^\s*[-*]?\s*doc:\s*`?([\w.-]+)`?\s*[=:]\s*([a-z-]+)", re.I | re.M)
COMMENT_MARKER = "<!-- cx-spec -->"

SPEC_TEMPLATE = """\
class: {name}
fires_when: <the event that starts it>
may:
  - <what an instance is allowed to do>
never:
  - <what no instance may do>
approval: <who has to say yes, and at which rung>
default_rung: 0
reach:
  - <the systems and credentials an instance may use>
reversible: <yes or no, in one step, and by whom>
context_floor:
  - <a fact or connection needed before a first instance is worth trying>
sources:
  - <a path in this repo that implements it>
"""


def parse_spec_yaml(text, source="<spec>"):
    """The subset of YAML a spec uses: `key: value` and `key:` followed by `  - item`.

    PyYAML is used when it is installed. Without it, anything outside that subset
    is an error, so a spec never parses to something it does not say.
    """
    try:
        import yaml
    except ModuleNotFoundError:
        yaml = None
    if yaml is not None:
        try:
            data = yaml.safe_load(text)
        except yaml.YAMLError as e:
            raise CxError(f"{source}: not valid YAML: {e}")
        if not isinstance(data, dict):
            raise CxError(f"{source}: a spec is a mapping of fields")
        return data

    def scalar(raw):
        raw = raw.strip()
        if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"":
            return raw[1:-1]
        if re.fullmatch(r"-?\d+", raw):
            return int(raw)
        return raw

    data, key = {}, None
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s+-\s+(.*)$", line)
        field = re.match(r"^([A-Za-z_][\w-]*):(?:\s+(.*))?$", line)
        if item and key is not None and isinstance(data.get(key), list):
            data[key].append(scalar(item.group(1)))
        elif field:
            key, value = field.group(1), field.group(2)
            if value is None or not value.strip():
                data[key] = []
            elif value.strip()[0] in "|>[{&*!":
                raise CxError(f"{source}:{n}: this YAML needs PyYAML (`pip install pyyaml`), or rewrite as `key: value` and `- item` lines")
            else:
                data[key] = scalar(value)
        else:
            raise CxError(f"{source}:{n}: cannot read {line.strip()!r}. Use `key: value`, or `key:` then `  - item` lines")
    return data


@dataclass
class Spec:
    path: str
    data: dict

    @property
    def name(self):
        return str(self.data.get("class") or Path(self.path).stem)

    def items(self, field):
        value = self.data.get(field) or []
        return [str(v) for v in value] if isinstance(value, list) else [str(value)]


def spec_files(spec_dir):
    return sorted(p for p in Path(spec_dir).glob("*") if p.suffix in (".yaml", ".yml") and p.is_file())


def load_specs(spec_dir, repo):
    specs = []
    for path in spec_files(spec_dir):
        rel = str(path.resolve().relative_to(repo.resolve())) if path.resolve().is_relative_to(repo.resolve()) else str(path)
        specs.append(Spec(rel, parse_spec_yaml(path.read_text(encoding="utf-8"), rel)))
    return specs


def source_matches(source, path):
    """A source is a file, a directory (prefix), or a glob. `**` and `*` both cross folders."""
    source = source.strip()
    if source.startswith("./"):
        source = source[2:]
    if any(c in source for c in "*?["):
        import fnmatch
        return fnmatch.fnmatchcase(path, source) or fnmatch.fnmatchcase(path, source.replace("**/", ""))
    source = source.rstrip("/")
    return path == source or path.startswith(source + "/")


def source_exists(source, repo):
    source = source.strip()
    if any(c in source for c in "*?["):
        return any(repo.glob(source))
    return (repo / source).exists()


def lint_specs(specs, repo, check_sources=True):
    """Return a list of (level, message). Level is error or warning."""
    out = []
    names = {}
    for spec in specs:
        where = spec.path
        for field in SPEC_REQUIRED:
            if field not in spec.data or spec.data[field] in (None, "", []):
                out.append(("error", f"{where}: missing `{field}`"))
        for field in SPEC_LISTS:
            if field in spec.data and spec.data[field] not in (None, "") and not isinstance(spec.data[field], list):
                out.append(("error", f"{where}: `{field}` is a list. Write each entry as `  - item`"))
        for field in SPEC_RECOMMENDED:
            if field not in spec.data:
                out.append(("warning", f"{where}: no `{field}`. See action-class.md"))
        rung = spec.data.get("default_rung")
        if rung is not None and rung not in (0, 1, 2, 3):
            out.append(("error", f"{where}: `default_rung` is 0, 1, 2, or 3, not {rung!r}"))
        reversible = spec.data.get("reversible", "")
        if rung == 3 and (reversible is False or str(reversible).lower().startswith("no")):
            out.append(("error", f"{where}: an irreversible class never runs silently, so `default_rung` cannot be 3"))
        if any("<" in v and ">" in v for f in SPEC_REQUIRED for v in spec.items(f)):
            out.append(("error", f"{where}: still has template placeholders in <angle brackets>"))
        if spec.name in names:
            out.append(("error", f"{where}: class `{spec.name}` is also defined in {names[spec.name]}"))
        names.setdefault(spec.name, where)
        if check_sources:
            for source in spec.items("sources"):
                if not ("<" in source and ">" in source) and not source_exists(source, repo):
                    out.append(("error", f"{where}: source `{source}` does not exist. The spec names code that is gone"))
    return out


def git(repo, *args):
    try:
        r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    except OSError as e:
        raise CxError(f"cannot run git: {e}")
    if r.returncode:
        raise CxError(f"git {' '.join(args)}: {r.stderr.strip() or 'failed'}")
    return r.stdout


def changed_paths(repo, base, head="HEAD"):
    return [p for p in git(repo, "diff", "--name-only", f"{base}...{head}").splitlines() if p]


def spec_at(repo, ref, path):
    """The spec as it was at ref, or None if it did not exist there."""
    try:
        text = git(repo, "show", f"{ref}:{path}")
    except CxError:
        return None
    return Spec(path, parse_spec_yaml(text, f"{ref}:{path}"))


def parse_dispositions(body):
    """{class: disposition} from `doc: <class> = <disposition>` lines. Unknown words are kept as-is."""
    found = {}
    for name, word in DISPOSITION_LINE.findall(body or ""):
        found[name] = DISPOSITIONS.get(word.lower(), word.lower())
    return found


@dataclass(eq=False)
class Touched:
    spec: Spec
    paths: list          # changed source paths
    spec_edited: bool    # the spec file itself changed
    new: bool            # the spec did not exist at base
    never_before: list
    may_before: list
    disposition: str = ""
    removed: bool = False  # the spec file was deleted: every promise on it goes

    def now(self, field):
        return [] if self.removed else self.spec.items(field)

    @property
    def never_changed(self):
        return self.new or self.never_before != self.now("never")

    @property
    def may_changed(self):
        return self.new or self.may_before != self.now("may")

    @property
    def needs_person(self):
        """A `never` line that moved always waits for a person's yes."""
        return self.never_changed


def affected(specs, changed, repo=None, base=None, spec_dir=None):
    """The specs a change touched, in register order, then any spec the change deleted."""
    out = []
    changed = list(changed)
    for spec in specs:
        paths = [p for p in changed if any(source_matches(s, p) for s in spec.items("sources"))]
        edited = spec.path in changed
        if not (paths or edited):
            continue
        before = spec_at(repo, base, spec.path) if (repo is not None and base) else None
        new = edited and repo is not None and base is not None and before is None
        never_before = before.items("never") if before else spec.items("never")
        may_before = before.items("may") if before else spec.items("may")
        out.append(Touched(spec, paths, edited, new, never_before, may_before))
    if repo is not None and base and spec_dir is not None and Path(spec_dir).resolve().is_relative_to(Path(repo).resolve()):
        prefix = str(Path(spec_dir).resolve().relative_to(Path(repo).resolve()))
        for path in changed:
            if Path(path).suffix in (".yaml", ".yml") and str(Path(path).parent) == prefix and not (Path(repo) / path).exists():
                before = spec_at(repo, base, path)
                if before is not None:
                    out.append(Touched(before, [], True, False, before.items("never"), before.items("may"), removed=True))
    return out


# A moved `never` is a moved promise, so the promise page moves with it.
NEVER_DISPOSITIONS = ("page", "update", "remove")


def gate(touched, require_all=False):
    """{touched: reason} for each spec that blocks the change."""
    blocking = {}
    for t in touched:
        if t.disposition and t.disposition not in DISPOSITIONS.values():
            blocking[t] = f"`{t.disposition}` is not a disposition"
        elif t.never_changed and t.disposition and t.disposition not in NEVER_DISPOSITIONS:
            blocking[t] = f"a moved `never` needs {', '.join(NEVER_DISPOSITIONS)}, not {t.disposition}"
        elif not t.disposition and t.needs_person:
            blocking[t] = "a moved `never` waits for a person's decision"
        elif not t.disposition and require_all:
            blocking[t] = "no disposition yet"
    return blocking


def lines_diff(before, after):
    removed = [f"- {v}" for v in before if v not in after]
    added = [f"+ {v}" for v in after if v not in before]
    return removed + added


def report_markdown(touched, blocking, problems):
    out = [COMMENT_MARKER, "### Specs this change touches", ""]
    if not touched:
        out.append("None. No source path on any spec changed, so no doc decision is waiting.")
    else:
        out += ["| Class | Why | `never` | Disposition |", "|---|---|---|---|"]
        for t in touched:
            why = ", ".join(f"`{p}`" for p in t.paths[:3]) + (f" and {len(t.paths) - 3} more" if len(t.paths) > 3 else "")
            if t.new:
                why = "new spec"
            elif t.removed:
                why = "spec deleted"
            elif t.spec_edited:
                why = (why + ", " if why else "") + "spec edited"
            never = "new" if t.new else ("**changed**" if t.never_changed else "unchanged")
            state = t.disposition or "unverified"
            if t in blocking:
                state = f"**{blocking[t]}**" if not t.disposition else f"{t.disposition}: **{blocking[t]}**"
            out.append(f"| `{t.spec.name}` | {why} | {never} | {state} |")
        waiting = [t for t in touched if not t.disposition or t in blocking]
        if waiting:
            out += [
                "",
                "Record one decision per class in the pull request description. The check re-runs when it is edited:",
                "",
                "```",
                *[f"doc: {t.spec.name} = {'update' if t.never_changed else 'no-page'}" for t in waiting],
                "```",
            ]
        out += [
            "",
            "`no-page` (spec only: the product reveals it), `page` (a line on the promise page), `guide` "
            "(a person still has to walk a sequence), `update` (the spec changes with the code), or `remove` "
            "(the product now says it). A moved `never` line always waits for a person.",
        ]
        for t in touched:
            if t.never_changed or t.may_changed:
                out += ["", f"<details><summary><code>{t.spec.name}</code>: what moved</summary>", "", "```diff"]
                if t.may_changed:
                    out += ["# may", *lines_diff(t.may_before if not t.new else [], t.now("may"))]
                if t.never_changed:
                    out += ["# never", *lines_diff(t.never_before if not t.new else [], t.now("never"))]
                out += ["```", "", "</details>"]
    if problems:
        out += ["", "**Register problems**", ""] + [f"- {level}: {msg}" for level, msg in problems]
    out += ["", "<sub>From `cx spec`. See responsibilities/documentation.md in the agentic CX manual.</sub>"]
    return "\n".join(out) + "\n"


def report_json(touched, blocking, problems):
    return json.dumps({
        "touched": [{
            "class": t.spec.name, "spec": t.spec.path, "paths": t.paths, "spec_edited": t.spec_edited,
            "new": t.new, "removed": t.removed, "never_changed": t.never_changed, "may_changed": t.may_changed,
            "disposition": t.disposition or None, "blocking": blocking.get(t),
        } for t in touched],
        "problems": [{"level": l, "message": m} for l, m in problems],
    }, indent=2) + "\n"


def report_text(touched, blocking, problems):
    out = []
    for level, msg in problems:
        out.append(f"{level}: {msg}")
    for t in touched:
        flag = "BLOCKS" if t in blocking else "ok"
        detail = blocking.get(t) or ("new" if t.new else "deleted" if t.removed else "never changed" if t.never_changed else "unverified")
        out.append(f"{flag:<6} {t.spec.name:<32} {t.disposition or '-':<10} {detail}  ({', '.join(t.paths) or t.spec.path})")
    if not touched:
        out.append("No spec touched.")
    return "\n".join(out) + "\n"


def cmd_spec(args):
    repo = Path(args.repo).resolve()
    spec_dir = (repo / args.specs) if not Path(args.specs).is_absolute() else Path(args.specs)
    if args.spec_command == "new":
        if not re.fullmatch(r"[a-z][a-z0-9_]*", args.name):
            raise CxError("a class name is lower_snake_case, like answer_behavior_question")
        path = spec_dir / f"{args.name}.yaml"
        if not write_new(path, SPEC_TEMPLATE.format(name=args.name)):
            raise CxError(f"{path} already exists")
        print(f"created  {path.relative_to(repo) if path.is_relative_to(repo) else path}")
        return 0
    if not spec_dir.is_dir():
        raise CxError(f"no spec register at {spec_dir}. Start one with `cx spec new <class>`")
    specs = load_specs(spec_dir, repo)
    problems = lint_specs(specs, repo, check_sources=not args.no_source_check)
    errors = [p for p in problems if p[0] == "error"]
    if args.spec_command == "lint":
        for level, msg in problems:
            print(f"{level}: {msg}")
        print(f"cx spec lint: {len(specs)} spec(s), {len(errors)} error(s), {len(problems) - len(errors)} warning(s)", file=sys.stderr)
        return 1 if errors else 0
    # check
    if args.changed is not None:
        stream = sys.stdin if args.changed == "-" else open(args.changed, encoding="utf-8")
        changed = [line.strip() for line in stream if line.strip()]
    elif args.base:
        changed = changed_paths(repo, args.base, args.head)
    else:
        raise CxError("give --base REF, or --changed FILE ('-' for stdin) with the changed paths")
    body = ""
    if args.body_file:
        body = sys.stdin.read() if args.body_file == "-" else Path(args.body_file).read_text(encoding="utf-8")
    touched = affected(specs, changed, repo, args.base, spec_dir)
    decided = parse_dispositions(body)
    for t in touched:
        t.disposition = decided.get(t.spec.name, "")
    blocking = gate(touched, args.require_disposition)
    render = {"markdown": report_markdown, "json": report_json, "text": report_text}[args.format]
    sys.stdout.write(render(touched, blocking, problems))
    return 1 if (blocking or errors) else 0


# --- MCP server: the manual for any agent host ---------------------------------
#
# `cx mcp serve` speaks the Model Context Protocol over stdio, with nothing but the
# standard library. Any host that supports MCP gets the same manual: its files as
# resources, the skills as prompts, and a few tools. Manual paths resolve against
# the kit, so the relative links inside a skill still work. Private files stay in
# the house and are never served: the host reads and writes those with its own
# file tools, after the same yes as always.

MCP_NAME = "agentic-cx"
MCP_URI = "cx://manual/"
MCP_TEXT_SUFFIXES = (".md", ".toml", ".yaml", ".yml", ".json", ".txt")


def manual_files(kit=ROOT):
    """Tracked text files of the manual, as relative paths. Never a private file."""
    try:
        listed = git(kit, "ls-files").splitlines()
    except CxError:
        listed = [str(p.relative_to(kit)) for p in kit.rglob("*") if p.is_file() and ".git" not in p.parts]
    private = {p.rstrip("/") for p in PRIVATE}
    keep = []
    for rel in listed:
        first = rel.split("/", 1)[0]
        if first in private or rel in private or first.startswith(".") or not rel.endswith(MCP_TEXT_SUFFIXES):
            continue
        keep.append(rel)
    return sorted(keep)


def resolve_manual(path, origin=None, kit=ROOT, files=None):
    """A manual path, a cx://manual/ URI, or a link relative to `origin`, as a path in `files`."""
    import posixpath
    path = (path or "").strip()
    if path.startswith(MCP_URI):
        path = path[len(MCP_URI):]
    path = path.split("#", 1)[0]
    origin = (origin or "").strip()
    if origin.startswith(MCP_URI):
        origin = origin[len(MCP_URI):]
    joined = posixpath.normpath(posixpath.join(posixpath.dirname(origin), path) if origin else path)
    files = manual_files(kit) if files is None else files
    if joined in files:
        return joined
    inside = [f for f in files if posixpath.dirname(f) == joined and f.endswith(".md")]
    if joined + "/README.md" in inside:
        return joined + "/README.md"
    if len(inside) == 1:  # a moment folder holds one PLAYBOOK.md, a skill folder one SKILL.md
        return inside[0]
    raise CxError(f"{path!r} is not a file in the manual" + (f" (resolved from {origin})" if origin else ""))


def first_heading(text, fallback):
    m = re.search(r"^# (.+)$", text, re.M)
    return m.group(1).strip() if m else fallback


def strip_front_matter(text):
    return re.sub(r"\A---\n.*?\n---\n", "", text, count=1, flags=re.S)


def skill_prompt(skill, kit=ROOT, house=None):
    house = house or house_dir()
    rel = SKILL_FILES[skill]
    body = strip_front_matter((kit / rel).read_text(encoding="utf-8")).strip()
    return (
        f"Follow the {skill} skill below. It comes from the agentic CX manual, served by the "
        f"`{MCP_NAME}` MCP server.\n\n"
        f"- Links in it are relative to `{rel}`. Read them with the `manual_read` tool, passing the link as "
        f"`path` and `{rel}` as `from`.\n"
        f"- This company's private files (stack.md, voice-queue.md, context-inbox.md, local/) live in "
        f"`{house}`. Read and write them there with your own file tools. They are never in the manual.\n"
        f"- Ask before you look, record each yes in `{house / 'local' / 'consent.toml'}`, and treat everything "
        f"customer-facing as a draft.\n\n---\n\n{body}\n"
    )


def server_instructions(kit=ROOT):
    agents = (kit / "AGENTS.md").read_text(encoding="utf-8")
    rules = re.search(r"^## Rules\n(.*?)(?=^## |\Z)", agents, re.S | re.M)
    return (
        "The agentic CX manual: an operating manual for the customer team at a company whose product is an agent. "
        "Start with the `setup` prompt if the operator has not been set up (`cx_status` says so). "
        "Read manual files with `manual_read`; links inside them are relative to the file they are in, so pass that "
        "file as `from`. Check every customer-facing draft with `lexicon_check`.\n\nRules:\n"
        + (rules.group(1).strip() if rules else "")
    )


MCP_TOOLS = [
    {
        "name": "manual_read",
        "description": "Read one file of the agentic CX manual. Pass a path like `skills/open/SKILL.md`, a cx://manual/ URI, "
                       "or a relative link together with `from`, the file the link appears in.",
        "inputSchema": {"type": "object", "properties": {
            "path": {"type": "string", "description": "A manual path, a cx://manual/ URI, or a relative link"},
            "from": {"type": "string", "description": "The file the link appears in, when `path` is relative to it"},
        }, "required": ["path"]},
    },
    {
        "name": "manual_search",
        "description": "Search the manual's files for a phrase, case-insensitive. Returns path:line: text for each match.",
        "inputSchema": {"type": "object", "properties": {
            "query": {"type": "string"},
            "limit": {"type": "integer", "description": "Most matches to return (default 30)"},
        }, "required": ["query"]},
    },
    {
        "name": "lexicon_check",
        "description": "Check a customer-facing draft against the house lexicon: banned phrases, words, openers, and "
                       "structural tells. Run it on every draft before showing it. On a violation, rewrite from the "
                       "source, do not patch the sentence.",
        "inputSchema": {"type": "object", "properties": {
            "text": {"type": "string", "description": "The draft reply"},
            "strict": {"type": "boolean", "description": "Treat warnings as failures"},
        }, "required": ["text"]},
    },
    {
        "name": "cx_status",
        "description": "What is waiting for this company: the stack, the voice queue and its cursor, the context inbox, "
                       "the last day note, and the last scheduled runs. A summary; no customer quotes.",
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "cx_doctor",
        "description": "What is set up, what is missing, and the next step for each.",
        "inputSchema": {"type": "object", "properties": {}},
    },
]


class McpServer:
    def __init__(self, kit=ROOT, house=None):
        self.kit = kit
        self.house = house or house_dir()
        self.files = manual_files(kit)

    # Each handler returns a result or raises McpError.
    def initialize(self, params):
        # The server uses only resources, prompts, and tools, which every protocol
        # version has, so it answers in the version the client asked for.
        return {
            "protocolVersion": params.get("protocolVersion") or "2025-06-18",
            "capabilities": {"resources": {}, "prompts": {}, "tools": {}},
            "serverInfo": {"name": MCP_NAME, "version": "0.1.0"},
            "instructions": server_instructions(self.kit),
        }

    def resources_list(self, params):
        out = []
        for rel in self.files:
            entry = {"uri": MCP_URI + rel, "name": rel, "mimeType": "text/markdown" if rel.endswith(".md") else "text/plain"}
            out.append(entry)
        return {"resources": out}

    def resources_read(self, params):
        rel = self.resolve(params.get("uri", ""))
        return {"contents": [{"uri": MCP_URI + rel, "mimeType": "text/markdown" if rel.endswith(".md") else "text/plain",
                              "text": (self.kit / rel).read_text(encoding="utf-8")}]}

    def prompts_list(self, params):
        prompts = []
        for skill, rel in SKILL_FILES.items():
            text = (self.kit / rel).read_text(encoding="utf-8")
            m = re.search(r"^description:\s*(.+)$", text, re.M)
            prompts.append({"name": skill, "description": m.group(1).strip() if m else first_heading(text, skill)})
        return {"prompts": prompts}

    def prompts_get(self, params):
        name = params.get("name", "")
        if name not in SKILL_FILES:
            raise McpError(-32602, f"no prompt named {name!r}. Prompts: {', '.join(SKILL_FILES)}")
        return {"description": f"The {name} skill", "messages": [
            {"role": "user", "content": {"type": "text", "text": skill_prompt(name, self.kit, self.house)}}]}

    def tools_list(self, params):
        return {"tools": MCP_TOOLS}

    def tools_call(self, params):
        name, args = params.get("name", ""), params.get("arguments") or {}
        handler = getattr(self, f"tool_{name}", None)
        if handler is None:
            raise McpError(-32602, f"no tool named {name!r}")
        try:
            text = handler(args)
        except CxError as e:
            return {"content": [{"type": "text", "text": str(e)}], "isError": True}
        return {"content": [{"type": "text", "text": text}], "isError": False}

    def resolve(self, path, origin=None):
        try:
            return resolve_manual(path, origin, self.kit, self.files)
        except CxError as e:
            raise McpError(-32602, str(e))

    def tool_manual_read(self, args):
        rel = resolve_manual(args.get("path", ""), args.get("from"), self.kit, self.files)
        return f"<!-- {MCP_URI}{rel} -->\n" + (self.kit / rel).read_text(encoding="utf-8")

    def tool_manual_search(self, args):
        query = (args.get("query") or "").strip().lower()
        if not query:
            raise CxError("give a query")
        limit = int(args.get("limit") or 30)
        hits = []
        for rel in self.files:
            for n, line in enumerate((self.kit / rel).read_text(encoding="utf-8").splitlines(), 1):
                if query in line.lower():
                    hits.append(f"{rel}:{n}: {line.strip()[:200]}")
                    if len(hits) >= limit:
                        return "\n".join(hits) + f"\n(first {limit} matches)"
        return "\n".join(hits) or f"No match for {query!r}."

    def tool_lexicon_check(self, args):
        findings = check_text(args.get("text") or "", load_lexicon(), "draft")
        strict = bool(args.get("strict"))
        errors = [f for f in findings if strict or not f.warning]
        lines = [str(f).removeprefix("draft:") for f in findings]
        verdict = "FAIL: rewrite from the source, do not patch the sentence." if errors else "PASS"
        return "\n".join([verdict] + lines)

    def tool_cx_status(self, args):
        status, problems = house_status(self.house)
        return f"House: {self.house}\n" + "\n".join(f"{label:<9} {text}" for label, text in status_lines(status, problems))

    def tool_cx_doctor(self, args):
        return "\n".join(f"{level:<5} {message}" for level, message in doctor(self.house))

    METHODS = {
        "initialize": "initialize", "ping": None,
        "resources/list": "resources_list", "resources/read": "resources_read",
        "prompts/list": "prompts_list", "prompts/get": "prompts_get",
        "tools/list": "tools_list", "tools/call": "tools_call",
    }

    def handle(self, message):
        """One JSON-RPC message in, one response out, or None for a notification."""
        if not isinstance(message, dict) or message.get("jsonrpc") != "2.0":
            return {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "not a JSON-RPC 2.0 message"}}
        if "id" not in message:
            return None  # notifications/initialized, cancellations: nothing to say
        method, mid = message.get("method", ""), message["id"]
        if method not in self.METHODS:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {method}"}}
        try:
            name = self.METHODS[method]
            result = {} if name is None else getattr(self, name)(message.get("params") or {})
        except McpError as e:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": e.code, "message": str(e)}}
        except (Exception, SystemExit) as e:  # a bug or a bad lexicon must not kill the host's session
            print(f"cx mcp: {method} failed: {e!r}", file=sys.stderr)
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": f"internal error: {e}"}}
        return {"jsonrpc": "2.0", "id": mid, "result": result}

    def serve(self, stdin=None, stdout=None):
        stdin, stdout = stdin or sys.stdin, stdout or sys.stdout
        for line in stdin:
            if not line.strip():
                continue
            try:
                message = json.loads(line)
            except ValueError:
                reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
            else:
                reply = self.handle(message)
            if reply is not None:
                stdout.write(json.dumps(reply) + "\n")
                stdout.flush()


class McpError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def mcp_launch(kit=ROOT):
    """The command a host runs to start the server."""
    return [sys.executable if Path(sys.executable).name.startswith("python") else "python3", str(kit / "scripts" / "cx"), "mcp", "serve"]


def mcp_config(host, house=None, kit=ROOT):
    """The setup for one host, as text to paste or a command to run."""
    cmd = mcp_launch(kit)
    env = {"CX_HOUSE": str(house)} if house else {}
    if host == "claude":
        flags = " ".join(f"-e {k}={shlex.quote(v)}" for k, v in env.items())
        return f"claude mcp add {MCP_NAME} --scope user {flags + ' ' if flags else ''}-- {shlex.join(cmd)}"
    if host == "codex":
        lines = [f"[mcp_servers.{MCP_NAME}]", f"command = {json.dumps(cmd[0])}", f"args = {json.dumps(cmd[1:])}"]
        if env:
            lines.append("env = { " + ", ".join(f"{k} = {json.dumps(v)}" for k, v in env.items()) + " }")
        return "# ~/.codex/config.toml\n" + "\n".join(lines)
    server = {"command": cmd[0], "args": cmd[1:]}
    if env:
        server["env"] = env
    if host == "vscode":
        server = {"type": "stdio", **server}
        return "// .vscode/mcp.json\n" + json.dumps({"servers": {MCP_NAME: server}}, indent=2)
    where = {"cursor": "~/.cursor/mcp.json", "gemini": "~/.gemini/settings.json", "json": "your host's MCP settings"}[host]
    return f"// {where}\n" + json.dumps({"mcpServers": {MCP_NAME: server}}, indent=2)


MCP_HOSTS = ("claude", "codex", "cursor", "gemini", "vscode", "json")


def cmd_mcp(args):
    if args.mcp_command == "serve":
        McpServer().serve()
        return 0
    if args.house:
        house = Path(args.house).expanduser().resolve()
    else:
        house = house_dir() if os.environ.get("CX_HOUSE") else None
    print(mcp_config(args.host, house))
    if house is None:
        print(f"\n# The house defaults to {ROOT}. Pass --house to keep the private files elsewhere.", file=sys.stderr)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="cx", description="Helpers for the agentic CX manual.")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check", help="scan replies against the banned lists in floor/voice/LEXICON.md")
    check.add_argument("files", nargs="*", help="files to check, or '-' for stdin")
    check.add_argument("--gold", action="store_true", help="check every gold reply in floor/evals/cases/")
    check.add_argument("--templates", action="store_true", help="check the examples in templates/customer/")
    check.add_argument("--strict", action="store_true", help="treat warnings as errors")
    check.add_argument("--quiet", action="store_true", help="no summary line")
    check.add_argument("--lexicon", help="path to a different lexicon file")
    init = sub.add_parser("init", help="create local/, the overlay, the queues, and local/consent.toml; never overwrites")
    init.add_argument("--quiet", action="store_true", help="do not count the files kept")
    sub.add_parser("doctor", help="say what is set up, what is missing, and the next step")
    status = sub.add_parser("status", help="what is waiting: the queue, the inbox, the stack, the last day note and runs")
    status.add_argument("--json", action="store_true", help="the same, as JSON, for other tools")
    models = sub.add_parser("models", help="print which model runs which skill, per harness")
    models.add_argument("--harness", help="one harness from models.toml")
    run = sub.add_parser("run", help="run a skill unattended, within local/consent.toml")
    run.add_argument("skill", choices=sorted(SKILL_FILES), help="open or close; the others wait on a person")
    run.add_argument("--harness", help="a harness from models.toml (default: CX_HARNESS, else the first on PATH)")
    run.add_argument("--dry-run", action="store_true", help="print the command instead of running it")
    spec = sub.add_parser("spec", help="lint the spec register, and name the specs a change touched")
    spec_sub = spec.add_subparsers(dest="spec_command", required=True)
    for name, help_text in (("lint", "check every spec has its fields and its sources exist"),
                            ("check", "name the specs a change touched and the doc decision each needs"),
                            ("new", "start a spec file for a new action class")):
        p = spec_sub.add_parser(name, help=help_text)
        p.add_argument("--repo", default=".", help="the product repo (default: the current directory)")
        p.add_argument("--specs", default="specs", help="the spec register, relative to --repo (default: specs)")
        if name == "new":
            p.add_argument("name", help="the class name, lower_snake_case")
        else:
            p.add_argument("--no-source-check", action="store_true", help="do not require each source path to exist")
        if name == "check":
            p.add_argument("--base", help="the ref the change is against; the diff is base...head")
            p.add_argument("--head", default="HEAD", help="default: HEAD")
            p.add_argument("--changed", help="a file of changed paths, one per line, or '-' for stdin; replaces the git diff")
            p.add_argument("--body-file", help="the pull request description, for `doc: <class> = <disposition>` lines")
            p.add_argument("--require-disposition", action="store_true", help="fail on any touched spec with no disposition, not only a moved `never`")
            p.add_argument("--format", choices=("text", "markdown", "json"), default="text")
    mcp = sub.add_parser("mcp", help="serve the manual over MCP to any agent host, or print a host's setup")
    mcp_sub = mcp.add_subparsers(dest="mcp_command", required=True)
    mcp_sub.add_parser("serve", help="speak MCP over stdio. Hosts start this; you do not run it by hand")
    mcp_config_p = mcp_sub.add_parser("config", help="print the setup for one host")
    mcp_config_p.add_argument("host", choices=MCP_HOSTS)
    mcp_config_p.add_argument("--house", help="where the private files live (default: CX_HOUSE, else this repo)")
    args = parser.parse_args(argv)
    commands = {"check": cmd_check, "init": cmd_init, "doctor": cmd_doctor, "models": cmd_models, "run": cmd_run, "spec": cmd_spec, "status": cmd_status, "mcp": cmd_mcp}
    try:
        return commands[args.command](args)
    except CxError as e:
        print(f"cx: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
